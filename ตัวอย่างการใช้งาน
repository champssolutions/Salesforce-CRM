# สร้าง contact (ต้องมี account_id ที่อยู่ในตาราง accounts)
curl -X POST http://localhost:4000/api/contacts \
  -H "Content-Type: application/json" \
  -d '{"account_id":1,"first_name":"สมชาย","last_name":"ใจดี","email":"somchai@acme.com","phone":"081-234-5678"}'

# ดึง contacts ของ account ที่ 1
curl http://localhost:4000/api/accounts/1/contacts

# ลบ account → contacts ที่ผูกอยู่จะถูกลบตาม (ON DELETE CASCADE)
curl -X DELETE http://localhost:4000/api/accounts/1
